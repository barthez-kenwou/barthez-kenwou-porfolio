# GHCR / Compose (production VPS - private repo → private package)
# Owner: barthez-kenwou  |  Image stays private; VPS must docker login GHCR.
GHCR_IMAGE=ghcr.io/barthez-kenwou/barthez-kenwou-porfolio
IMAGE_TAG=latest

# Optional: which Dockerfile under infra/docker/ (local builds only)
DOCKERFILE=Dockerfile

# Watchtower (docker compose --profile watchtower up -d)
# DOCKER_CONFIG_JSON=~/.docker/config.json
# WATCHTOWER_POLL_INTERVAL=300

# Build-time Vite public vars (local image builds)
VITE_SITE_URL=https://barthez-kenwou.dev
VITE_APP_URL=https://barthez-kenwou.dev
VITE_ENVIRONMENT=production
VITE_ENABLE_PWA=true
VITE_APP_TITLE=Barthez Kenwou Portfolio
# VITE_API_BASE_URL=https://api.barthez-kenwou.dev
# VITE_PRESENTATION_YOUTUBE_URL=
