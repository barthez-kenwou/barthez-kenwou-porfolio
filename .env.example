# Environment variables required for the project
# Copy this file to `.env` and fill actual values. Do NOT commit `.env`.

# Base URLs
VITE_SITE_URL=https://barthez-kenwou.dev
VITE_APP_URL=https://barthez-kenwou.dev

# Vite / Node env
NODE_ENV=production
VITE_ENVIRONMENT=production

# Network
PORT=5173
HOST=0.0.0.0

# Feature flags
VITE_ENABLE_PWA=true

# API origin only (client appends /api/v1).
# Local Vite: leave empty — requests use same-origin /api via vite proxy (CSRF cookies).
# Production: https://api.barthez-kenwou.dev
VITE_API_BASE_URL=
# Dev proxy (default https://api.barthez-kenwou.dev)
VITE_DEV_PROXY_TARGET=https://api.barthez-kenwou.dev
# Local API: VITE_DEV_PROXY_TARGET=http://127.0.0.1:3000

# Presentation video URL is managed in Admin → Contact info → Social (CMS).

# App
VITE_APP_TITLE=Barthez Kenwou Portfolio

# Admin auth: JWT against the API (default). No silent mock login.
VITE_ADMIN_USE_API=true
# Offline UI only (requires VITE_ADMIN_USE_API=false) — never use in production
# VITE_ADMIN_EMAIL=
# VITE_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Docker / GHCR (optional locally - see infra/docker/.env.example)
# -----------------------------------------------------------------------------
# GHCR_IMAGE=ghcr.io/barthez-kenwou/barthez-kenwou-porfolio
# IMAGE_TAG=latest
# WEB_HOST_PORT=8080
